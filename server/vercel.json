{
    "version": 2,
    "builds": [
      {
        "src": "api/index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/api/index.js"
      }
    ],
    "env": {
      "MONGODB_URI": "@mongodb_uri",
      "JWT_SECRET": "@jwt_secret",
      "STRIPE_SECRET_KEY": "@stripe_secret_key",
      "RAZORPAY_KEY_ID": "@razorpay_key_id",
      "RAZORPAY_SECRET": "@razorpay_secret"
    }
}